---
import '../../styles/tokens.css';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#021a2e" />
    <title>Letter Bay V2 · Compatibility</title>
  </head>
  <body>
    <main class="compat" data-engine="v2-compat">
      <div>
        <small>LETTER BAY V2</small>
        <strong>Kompatibilitätsmodus</strong>
        <p>Phase 1 bewahrt das vollständige Legacy-Gameplay, während die neue Architektur aufgebaut wird.</p>
      </div>
    </main>

    <script>
      import { resolveV2CompatibilityTarget } from '../../game/compatRouter';

      window.location.replace(resolveV2CompatibilityTarget(import.meta.env.BASE_URL));
    </script>
  </body>
</html>

<style>
  .compat {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 24px;
    text-align: center;
  }
  .compat small {
    display: block;
    color: var(--lb-turquoise);
    letter-spacing: 0.16em;
    font-weight: 900;
  }
  .compat strong {
    display: block;
    margin-top: 8px;
    color: var(--lb-gold);
    font: 900 2rem Georgia, serif;
  }
  .compat p { max-width: 34rem; opacity: 0.85; }
</style>
