---
import '../styles/tokens.css';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#021a2e" />
    <title>Tula's Island · Letter Bay</title>
  </head>
  <body>
    <main class="compat">
      <div>
        <strong>Letter Bay</strong>
        <p>Sicherer Kompatibilitätsmodus wird geladen …</p>
      </div>
    </main>

    <script>
      import { resolveEngineTarget } from '../game/compatRouter';

      const target = resolveEngineTarget(window.location.search, import.meta.env.BASE_URL);
      window.location.replace(target);
    </script>
  </body>
</html>

<style>
  .compat {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 24px;
    text-align: center;
  }
  .compat strong {
    color: var(--lb-gold);
    font: 900 2rem Georgia, serif;
  }
  .compat p { opacity: 0.85; }
</style>
